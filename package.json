{
  "name": "@paperboat/shared",
  "version": "0.1.0-alpha.1",
  "description": "Paperboat's shared UI kit: tokens, Geist fonts, controls, blocks and ports, view.icon renderer, dashboard, shell, canvas utilities. No domain logic.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@xyflow/react": "^12.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components": {
      "types": "./src/components.ts",
      "default": "./src/components.ts"
    },
    "./icon": {
      "types": "./src/icon.ts",
      "default": "./src/icon.ts"
    },
    "./fixtures/icons": {
      "types": "./test/fixtures/icons.ts",
      "default": "./test/fixtures/icons.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./plates.css": "./src/plates.css"
  }
}
