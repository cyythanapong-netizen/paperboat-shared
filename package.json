{
  "name": "@paperboat/shared",
  "version": "0.1.0-alpha.7",
  "description": "Paperboat's shared UI kit: tokens, Geist fonts, controls, blocks and ports, view.icon renderer, dashboard, shell, canvas utilities. No domain logic.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@xyflow/react": "^12.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "three": "^0.187.0",
    "@types/three": "^0.187.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components": {
      "types": "./src/components.ts",
      "default": "./src/components.ts"
    },
    "./icon": {
      "types": "./src/icon.ts",
      "default": "./src/icon.ts"
    },
    "./fixtures/icons": {
      "types": "./test/fixtures/icons.ts",
      "default": "./test/fixtures/icons.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./plates.css": "./src/plates.css",
    "./viewCube": {
      "types": "./src/viewCube.ts",
      "default": "./src/viewCube.ts"
    },
    "./scope": {
      "types": "./src/scope/index.ts",
      "default": "./src/scope/index.ts"
    },
    "./scope.css": "./src/scope/scope.css",
    "./widgets": {
      "types": "./src/widgets.ts",
      "default": "./src/widgets.ts"
    },
    "./protocol": {
      "types": "./src/protocol.ts",
      "default": "./src/protocol.ts"
    },
    "./plot": {
      "types": "./src/plot/index.ts",
      "default": "./src/plot/index.ts"
    },
    "./station": {
      "types": "./src/station/index.ts",
      "default": "./src/station/index.ts"
    },
    "./dashboard": {
      "types": "./src/Dashboard.tsx",
      "default": "./src/Dashboard.tsx"
    },
    "./files": {
      "types": "./src/files/index.ts",
      "default": "./src/files/index.ts"
    },
    "./files.css": "./src/files/files.css"
  },
  "peerDependencies": {
    "three": ">=0.187.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  }
}
